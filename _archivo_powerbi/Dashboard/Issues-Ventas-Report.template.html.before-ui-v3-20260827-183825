<title>Issues Ventas · Control de proyectos</title>
<style>
:root{--ink:#1d1d1f;--muted:#86868b;--line:rgba(0,0,0,.07);--bg:#f5f5f7;--blue:#007aff;--teal:#1aa6a6;--green:#34c759;--amber:#ff9500;--red:#ff3b30;--purple:#af52de;--shadow:0 1px 2px rgba(0,0,0,.04),0 10px 30px rgba(0,0,0,.065)}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}button,input,select{font:inherit}.shell{width:min(100%,1720px);min-height:100vh;margin:auto;padding:20px;display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px}.sidebar{position:sticky;top:20px;height:calc(100vh - 40px);padding:27px 24px;background:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.92);border-radius:28px;box-shadow:var(--shadow);backdrop-filter:blur(30px) saturate(180%);overflow:hidden}.brand{display:flex;align-items:center;gap:11px}.mark{width:44px;height:44px;display:grid;place-items:center;border-radius:15px;color:#fff;background:linear-gradient(145deg,var(--blue),var(--purple));font-size:12px;font-weight:800;box-shadow:0 8px 20px rgba(0,122,255,.2)}.brand strong,.brand small{display:block}.brand strong{font-size:13px;letter-spacing:.08em}.brand small{margin-top:4px;color:var(--muted);font-size:10px}.eyebrow{margin:0;color:var(--muted);font-size:9px;font-weight:800;letter-spacing:.18em}.summary{margin-top:42px}.donut{--p:0deg;--c:var(--green);position:relative;display:grid;place-items:center;border-radius:50%;background:conic-gradient(var(--c) 0 var(--p),rgba(120,120,128,.16) var(--p) 360deg)}.donut:after{content:"";position:absolute;inset:15%;border-radius:50%;background:#fff}.donut.big{width:160px;height:160px;margin:21px auto}.donut.small{width:72px;height:72px;margin:auto}.donut-inner{position:relative;z-index:1;display:grid;text-align:center}.donut-inner strong{font-size:25px;line-height:1}.donut.small strong{font-size:16px}.donut-inner span{margin-top:5px;color:#91a4b8;font-size:8px;text-transform:uppercase}.counts{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid rgba(0,0,0,.08)}.counts div{padding:13px 5px;text-align:center}.counts div+div{border-left:1px solid rgba(0,0,0,.08)}.counts span,.counts strong{display:block}.counts span{color:var(--muted);font-size:8px;text-transform:uppercase}.counts strong{margin-top:5px;font-size:16px}.roster{margin-top:24px}.roster-list{margin-top:9px;max-height:34vh;overflow:auto;padding-right:3px}.roster-team+.roster-team{margin-top:7px}.roster-team-head{width:100%;display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding:7px 8px;border:1px solid rgba(0,0,0,.08);border-radius:9px;background:rgba(0,0,0,.025);color:var(--ink);font-size:10px;font-weight:700;text-align:left;cursor:pointer}.roster-team-head:hover{background:rgba(0,0,0,.06)}.roster-team-head.active{color:#fff;background:var(--blue);border-color:var(--blue)}.roster-team-meta{flex:none;color:var(--muted);font-size:8px}.roster-team-head.active .roster-team-meta{color:#dcecf8}.roster-members{padding:4px 9px 0}.roster-member{display:flex;justify-content:space-between;gap:8px;padding:3px 0;color:#3a3a3c;font-size:9px}.roster-member span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.roster-member b{flex:none;color:var(--blue);font-size:8px;font-variant-numeric:tabular-nums}.side-foot{position:absolute;left:24px;right:24px;bottom:18px;color:var(--muted);font-size:9px}.side-foot small{display:block;margin-top:4px}.dot{width:7px;height:7px;display:inline-block;margin-right:6px;border-radius:50%;background:var(--green)}.main{min-width:0;padding-bottom:38px}.header{position:sticky;top:20px;z-index:10;display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:16px;padding:17px 20px;border:1px solid rgba(255,255,255,.9);border-radius:24px;background:rgba(255,255,255,.76);box-shadow:var(--shadow);backdrop-filter:blur(30px) saturate(180%)}.header h1{margin:6px 0 0;font-size:34px;line-height:.96;letter-spacing:-.035em}.header h1 span{color:transparent;background:linear-gradient(90deg,var(--blue),var(--purple));background-clip:text;-webkit-background-clip:text}.btn{padding:10px 15px;border:0;border-radius:999px;color:#424245;background:rgba(120,120,128,.12);font-size:10px;font-weight:700;cursor:pointer}.btn:hover{color:#fff;background:var(--blue)}.filters,.discipline,.panel{border:1px solid rgba(0,0,0,.045);background:#fff;border-radius:22px;box-shadow:var(--shadow)}.filters{display:grid;grid-template-columns:minmax(0,2fr) minmax(170px,.65fr) minmax(280px,1fr);gap:12px;padding:14px}.filter-secondary{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.8fr);gap:12px;padding-top:2px}.field label{display:block;margin:0 0 8px 5px;color:var(--muted);font-size:8px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.field select{width:100%;height:39px;padding:8px 12px;border:0;border-radius:999px;color:#424245;background:rgba(120,120,128,.11);outline:none;font-size:10px}.filter-buttons{display:flex;flex-wrap:wrap;gap:5px;padding:5px;border-radius:18px;background:rgba(120,120,128,.11)}.filter-buttons button{padding:8px 12px;border:0;border-radius:999px;color:#424245;background:transparent;font-size:9px;font-weight:650;cursor:pointer}.filter-buttons button:hover{color:var(--blue);background:rgba(255,255,255,.72)}.filter-buttons button.active{color:#fff;background:var(--blue);box-shadow:0 2px 8px rgba(0,122,255,.25)}.discipline-grid{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:12px;margin-top:14px}.discipline{padding:16px 13px 13px}.discipline h3{margin:0 0 9px;color:#424245;font-size:8px;letter-spacing:.08em;text-align:center}.discipline-meta{display:flex;justify-content:space-between;margin-top:9px;color:var(--muted);font-size:8px}.grid{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(410px,1.7fr);gap:14px;margin-top:14px}.charts{display:grid;grid-template-columns:minmax(500px,2fr) minmax(270px,.9fr);gap:14px;margin-top:14px}.panel{min-width:0}.panel-head{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px 11px;border-bottom:1px solid rgba(0,0,0,.055)}.panel-head h2,.detail-head h2{margin:3px 0 0;font-size:16px;letter-spacing:-.02em}.panel-head>span,.detail-head small{color:var(--muted);font-size:8px}.legend{display:flex;gap:13px;align-items:center;flex-wrap:wrap;justify-content:flex-end;color:#6e6e73;font-size:8px}.legend-item{display:flex;align-items:center;gap:5px;white-space:nowrap}.legend-swatch{width:17px;height:3px;border-radius:4px}.legend-swatch.blue{background:var(--blue)}.legend-swatch.teal{background:var(--teal)}.ranking{padding:12px 14px}.rank{display:flex;align-items:center;gap:9px;margin-bottom:10px}.rank-no{width:21px;height:21px;display:grid;place-items:center;flex:none;border-radius:50%;color:var(--blue);background:rgba(0,122,255,.1);font-size:8px;font-weight:800}.rank:first-child .rank-no{color:#fff;background:var(--blue)}.rank-info{min-width:0;flex:1}.rank-label{display:flex;justify-content:space-between;gap:8px;margin-bottom:4px;font-size:9px}.bar{height:6px;border-radius:5px;background:rgba(120,120,128,.12);overflow:hidden}.bar i{height:100%;display:block;background:linear-gradient(90deg,var(--teal),var(--blue),var(--purple))}.mini-table{padding:0 12px 8px}.mini-row{display:grid;grid-template-columns:.8fr 1.55fr 48px 55px 58px;gap:7px;align-items:center;min-height:28px;border-bottom:1px solid rgba(0,0,0,.055);color:#424245;font-size:9px}.mini-row.team-summary{background:rgba(0,122,255,.04);font-weight:700}.mini-row span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mini-row b{text-align:center}.mini-head{min-height:31px;color:var(--muted);font-size:8px;font-weight:800;text-transform:uppercase}.closed{color:var(--green)}.rate{color:var(--blue)}.canvas-wrap{height:250px;padding:10px 12px 13px}.canvas-wrap canvas{width:100%;height:100%}.detail{margin-top:14px}.detail-head{display:flex;justify-content:space-between;align-items:end;gap:16px;padding:16px 18px;border-bottom:1px solid rgba(0,0,0,.055)}.detail-controls{display:grid;grid-template-columns:minmax(150px,.8fr) minmax(220px,1.2fr);gap:9px;align-items:end}.table-wrap{max-height:430px;overflow-y:auto;overflow-x:hidden;border-radius:0}table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:9px}th,td{padding:8px 10px;border-bottom:1px solid rgba(0,0,0,.05);text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}th{position:sticky;top:0;z-index:1;color:var(--muted);background:rgba(245,245,247,.97);font-size:8px;text-transform:uppercase}th:nth-child(1){width:8%}th:nth-child(2){width:14%}th:nth-child(3){width:20%}th:nth-child(4){width:10%}th:nth-child(5){width:12%}th:nth-child(6){width:10%}th:nth-child(7){width:17%}th:nth-child(8){width:9%}tbody tr{cursor:pointer;transition:background .12s ease}tbody tr:hover{background:rgba(0,122,255,.045)}tbody tr.selected{background:rgba(0,122,255,.09)}td.title{max-width:none}.pill{display:inline-block;padding:3px 7px;border-radius:999px;color:#5e6d7c;background:#e9eef2;font-size:8px;font-weight:700}.pill.closed,.pill.completed{color:#1f7a36;background:rgba(52,199,89,.14)}.pill.open,.pill.draft,.pill.in-review{color:#a45900;background:rgba(255,149,0,.15)}.issue-description{display:none;margin:0 14px 14px;padding:14px 16px;border:1px solid rgba(0,0,0,.06);border-radius:15px;background:#fafafa}.issue-description.visible{display:block}.issue-description-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:8px}.issue-description h3{margin:0;font-size:12px}.issue-description .meta{color:var(--muted);font-size:8px}.issue-description p{margin:0;color:#424245;font-size:10px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}.note{margin:0;padding:9px 13px;color:#84909d;font-size:8px}.empty{padding:30px;color:#8090a0;text-align:center;font-size:10px}@media(max-width:1100px){.discipline-grid{grid-template-columns:repeat(3,1fr)}.charts{grid-template-columns:1fr}}@media(max-width:900px){.shell{display:block;padding:12px}.sidebar{position:relative;top:0;height:auto;margin-bottom:14px}.side-foot{position:static;margin-top:22px}.header{top:10px}.filters,.grid,.filter-secondary{grid-template-columns:1fr}.discipline-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.detail-head{align-items:stretch;flex-direction:column}.detail-controls{grid-template-columns:1fr}.discipline-grid{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="shell">
<aside class="sidebar">
<div class="brand"><span class="mark">IV</span><div><strong>ISSUES VENTAS</strong><small>Control de proyectos</small></div></div>
<section class="summary"><p class="eyebrow">CANTIDAD DE ISSUES</p><div id="mainDonut"></div><div class="counts"><div><span>Total</span><strong id="total">0</strong></div><div><span>Abiertos</span><strong id="open">0</strong></div><div><span>Cerrados</span><strong id="closed">0</strong></div></div></section>
<section class="roster"><p class="eyebrow" id="rosterTitle">EQUIPOS E INTEGRANTES</p><div class="roster-list" id="rosterList"></div></section>
<div class="side-foot"><div><span class="dot"></span>Snapshot VENTAS_ISSUES</div><small id="updated"></small></div>
</aside>
<main class="main">
<header class="header"><div><p class="eyebrow">PORTAFOLIO BIM · VENTAS</p><h1>Seguimiento de <span>issues</span></h1></div><button class="btn" id="reset">Restablecer filtros</button></header>
<section class="filters">
<div class="field"><label>Proyecto</label><div class="filter-buttons" id="projectButtons"></div></div>
<div class="field"><label for="monthFilter">Mes de creación</label><select id="monthFilter"></select></div>
<div class="field"><label>Tipo de issue</label><div class="filter-buttons" id="typeButtons"></div></div>
<div class="filter-secondary"><div class="field"><label>Equipo</label><div class="filter-buttons" id="teamButtons"></div></div><div class="field"><label for="memberFilter">Integrante</label><select id="memberFilter"></select></div></div>
</section>
<section class="discipline-grid" id="disciplines"></section>
<section class="grid"><article class="panel"><div class="panel-head"><div><p class="eyebrow">DESEMPEÑO</p><h2>Ranking</h2></div><span>% cerrado</span></div><div class="ranking" id="ranking"></div></article><article class="panel"><div class="panel-head"><div><p class="eyebrow">RESPONSABLES</p><h2>Issues por equipo y usuario</h2></div><span>Principales responsables</span></div><div class="mini-table" id="people"></div></article></section>
<section class="charts">
<article class="panel"><div class="panel-head"><div><p class="eyebrow">VOLUMEN MENSUAL</p><h2>Histórico de issues</h2></div><div class="legend"><span class="legend-item"><i class="legend-swatch blue"></i>Issues creados</span><span class="legend-item"><i class="legend-swatch teal"></i>Issues cerrados</span></div></div><div class="canvas-wrap"><canvas id="history"></canvas></div></article>
<article class="panel"><div class="panel-head"><div><p class="eyebrow">EFICIENCIA</p><h2>Tendencia</h2></div><div class="legend"><span class="legend-item"><i class="legend-swatch blue"></i>% cerrados</span></div></div><div class="canvas-wrap"><canvas id="rate"></canvas></div></article>
</section>
<section class="panel detail"><div class="detail-head"><div><p class="eyebrow">DATOS ORGANIZADOS</p><h2>Detalle de issues</h2></div><div class="detail-controls"><div class="field"><label for="detailStatus">Estado del issue</label><select id="detailStatus"></select></div><div class="field"><label for="detailAssignee">Asignado a</label><select id="detailAssignee"></select></div></div></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>ProyectoConcurso</th><th>Título</th><th>Estado</th><th>Disciplina</th><th>Equipo</th><th>Asignado a</th><th>Creado</th></tr></thead><tbody id="details"></tbody></table></div><div class="issue-description" id="issueDescription"><div class="issue-description-top"><div><p class="eyebrow">DESCRIPCIÓN</p><h3 id="descriptionTitle">Issue seleccionado</h3></div><span class="meta" id="descriptionMeta"></span></div><p id="descriptionText"></p></div><p class="note" id="detailNote"></p></section>
</main></div>
<script id="issues-data" type="application/json">__ISSUES_DATA_JSON__</script>
<script>
(()=>{
const snapshot=JSON.parse(document.getElementById('issues-data').textContent),CLOSED=new Set(['Closed','Completed','Cerrado','Completado']),OPEN=new Set(['Open','Draft','In Review','Pending','Abierto','Pendiente']);
const MONTHS=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
const $=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),txt=v=>v==null?'':String(v).trim();
const rawRows=Array.isArray(snapshot.rows)?snapshot.rows:[],val=(r,...names)=>{for(const n of names)if(Object.prototype.hasOwnProperty.call(r,n)&&r[n]!=null)return r[n];return null};
const rows=rawRows.map(r=>({id:txt(val(r,'ID','id')),title:txt(val(r,'Title','title')),description:txt(val(r,'Description','Descripción','description')),status:txt(val(r,'Status','status'))||'Sin estado',type:txt(val(r,'Type','type'))||'Sin tipo',assignee:txt(val(r,'Assigned to','assignee'))||'Sin asignar',createdOn:val(r,'Created on','createdOn'),closedAt:val(r,'Closed at','closedAt'),discipline:txt(val(r,'Disciplina','discipline'))||'SIN DISCIPLINA',team:txt(val(r,'Equipo','team'))||'SIN EQUIPO',project:txt(val(r,'ProyectoConcurso','project'))||'SIN PROYECTO'}));
const key=d=>{const s=txt(d),m=s.match(/^(\d{4})-(\d{2})/);if(m)return`${m[1]}-${m[2]}`;const x=new Date(s);return isNaN(x)?null:`${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}`},identity=r=>`${r.project}|||${r.id}`,distinct=a=>new Set(a.map(identity)).size,metric=a=>{const total=distinct(a),closed=distinct(a.filter(r=>CLOSED.has(r.status))),open=Math.max(0,total-closed);return{total,closed,open,rate:total?closed/total:0}},pct=n=>`${Math.round((n||0)*100)}%`,number=n=>(n||0).toLocaleString('es-MX'),color=r=>r>=.8?'#34c759':r>=.65?'#ff9500':'#ff3b30',donut=(m,big=false)=>`<div class="donut ${big?'big':'small'}" style="--p:${m.rate*360}deg;--c:${color(m.rate)}"><div class="donut-inner"><strong>${pct(m.rate)}</strong><span>cerrados</span></div></div>`;
const projects=[...new Set(rows.map(r=>r.project))].sort((a,b)=>a.localeCompare(b,'es')),types=[...new Set(rows.map(r=>r.type))].sort((a,b)=>a.localeCompare(b,'es')),disciplines=[...new Set(rows.map(r=>r.discipline))].sort((a,b)=>a.localeCompare(b,'es')),monthKeys=[...new Set(rows.map(r=>key(r.createdOn)).filter(Boolean))].sort();
let state={project:'Todos',month:'Todos',type:'Todos',team:'Todos',member:'Todos',detailStatus:'Todos',detailAssignee:'Todos',selectedIssue:null};
function baseRows(){return rows.filter(r=>(state.project==='Todos'||r.project===state.project)&&(state.month==='Todos'||key(r.createdOn)===state.month)&&(state.type==='Todos'||r.type===state.type))}
function filtered(){return baseRows().filter(r=>(state.team==='Todos'||r.team===state.team)&&(state.member==='Todos'||r.assignee===state.member))}
function buttons(id,values,current,fn){$(id).innerHTML=['Todos',...values].map(v=>`<button type="button" class="${v===current?'active':''}" data-value="${esc(v)}">${esc(v)}</button>`).join('');$(id).querySelectorAll('button').forEach(b=>b.onclick=()=>fn(b.dataset.value))}
function select(id,values,current,format=v=>v){const all=['Todos',...values];if(!all.includes(current))current='Todos';$(id).innerHTML=all.map(v=>`<option value="${esc(v)}">${esc(v==='Todos'?'Todos':format(v))}</option>`).join('');$(id).value=current;return current}
function availableTeams(){return[...new Set(baseRows().map(r=>r.team).filter(t=>t!=='SIN EQUIPO'))].sort((a,b)=>a.localeCompare(b,'es'))}
function availableMembers(){const base=baseRows().filter(r=>state.team==='Todos'||r.team===state.team);return[...new Set(base.map(r=>r.assignee).filter(x=>x&&x!=='Sin asignar'))].sort((a,b)=>a.localeCompare(b,'es'))}
function renderRoster(){const base=baseRows(),teams=availableTeams();if(state.team!=='Todos'&&!teams.includes(state.team))state.team='Todos';$('rosterTitle').textContent=state.project==='Todos'?'EQUIPOS E INTEGRANTES':`EQUIPO EN ${state.project}`;$('rosterList').innerHTML=teams.map(team=>{const rs=base.filter(r=>r.team===team),tm=metric(rs),people=[...new Set(rs.map(r=>r.assignee))].sort((a,b)=>a.localeCompare(b,'es'));return`<div class="roster-team"><button class="roster-team-head${state.team===team?' active':''}" data-team="${esc(team)}"><span>${esc(team)}</span><span class="roster-team-meta">${tm.closed}/${tm.total} · ${pct(tm.rate)}</span></button><div class="roster-members">${people.map(p=>{const pm=metric(rs.filter(r=>r.assignee===p));return`<div class="roster-member"><span title="${esc(p)}">${esc(p)}</span><b>${pm.closed}/${pm.total} · ${pct(pm.rate)}</b></div>`}).join('')}</div></div>`}).join('')||'<div class="empty">Sin equipos</div>';$('rosterList').querySelectorAll('[data-team]').forEach(b=>b.onclick=()=>{state.team=state.team===b.dataset.team?'Todos':b.dataset.team;state.member='Todos';render()})}
function monthRange(start,end){const out=[],d=new Date(`${start}-01T00:00:00Z`),limit=new Date(`${end}-01T00:00:00Z`);while(d<=limit){out.push(`${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}`);d.setUTCMonth(d.getUTCMonth()+1)}return out}
function trendRows(){const source=rows.filter(r=>(state.project==='Todos'||r.project===state.project)&&(state.type==='Todos'||r.type===state.type)&&(state.team==='Todos'||r.team===state.team)&&(state.member==='Todos'||r.assignee===state.member));const keys=[...new Set(source.map(r=>key(r.createdOn)).filter(Boolean))].sort();if(!keys.length)return[];return monthRange(keys[0],keys.at(-1)).map(k=>({label:`${MONTHS[+k.slice(5)-1]} ${k.slice(2,4)}`,...metric(source.filter(r=>key(r.createdOn)===k))}))}
function drawChart(canvas,points,rateOnly=false){const rect=canvas.getBoundingClientRect(),dpr=window.devicePixelRatio||1,w=Math.max(300,rect.width),h=Math.max(175,rect.height);canvas.width=w*dpr;canvas.height=h*dpr;const c=canvas.getContext('2d');c.scale(dpr,dpr);c.clearRect(0,0,w,h);const pad={l:46,r:20,t:20,b:34},pw=w-pad.l-pad.r,ph=h-pad.t-pad.b;c.font='9px Segoe UI';c.lineCap='round';c.lineJoin='round';if(!points.length){c.fillStyle='#86868b';c.fillText('Sin datos',pad.l,pad.t+20);return}const max=rateOnly?1:Math.max(1,...points.map(p=>Math.max(p.total,p.closed)));for(let i=0;i<=3;i++){const yy=pad.t+ph*i/3;c.strokeStyle='rgba(120,120,128,.18)';c.lineWidth=1;c.beginPath();c.moveTo(pad.l,yy);c.lineTo(w-pad.r,yy);c.stroke();const v=max*(1-i/3);c.fillStyle='#708090';c.fillText(rateOnly?pct(v):number(Math.round(v)),5,yy+3)}const x=i=>pad.l+(points.length===1?pw/2:pw*i/(points.length-1)),y=v=>pad.t+ph*(1-v/max);const series=rateOnly?[['rate','#007aff']]:[['total','#007aff'],['closed','#1aa6a6']];series.forEach(([field,col])=>{c.strokeStyle=col;c.lineWidth=2.5;c.beginPath();points.forEach((p,i)=>{const xx=x(i),yy=y(p[field]);i?c.lineTo(xx,yy):c.moveTo(xx,yy)});c.stroke();points.forEach((p,i)=>{const xx=x(i),yy=y(p[field]);c.fillStyle='#fff';c.strokeStyle=col;c.lineWidth=2;c.beginPath();c.arc(xx,yy,3.4,0,Math.PI*2);c.fill();c.stroke();if(rateOnly){c.fillStyle=col;c.font='bold 9px Segoe UI';const label=pct(p.rate);c.fillText(label,Math.max(2,xx-c.measureText(label).width/2),Math.max(10,yy-9));c.font='9px Segoe UI'}})});c.fillStyle='#708090';points.forEach((p,i)=>{if(points.length<=10||i%Math.ceil(points.length/8)===0||i===points.length-1)c.fillText(p.label,x(i)-12,h-8)})}
function renderDescription(r){const box=$('issueDescription');if(!r){box.classList.remove('visible');return}$('descriptionTitle').textContent=`${r.id||'Issue'} · ${r.title||'Sin título'}`;$('descriptionMeta').textContent=`${r.project} · ${r.team} · ${r.assignee}`;$('descriptionText').textContent=r.description||'Este issue no tiene descripción registrada.';box.classList.add('visible')}
function render(){buttons('projectButtons',projects,state.project,v=>{state.project=v;state.team='Todos';state.member='Todos';state.selectedIssue=null;render()});buttons('typeButtons',types,state.type,v=>{state.type=v;state.selectedIssue=null;render()});state.month=select('monthFilter',monthKeys,state.month,k=>`${MONTHS[+k.slice(5)-1]} ${k.slice(0,4)}`);const teams=availableTeams();if(state.team!=='Todos'&&!teams.includes(state.team))state.team='Todos';buttons('teamButtons',teams,state.team,v=>{state.team=v;state.member='Todos';state.selectedIssue=null;render()});const members=availableMembers();state.member=select('memberFilter',members,state.member);renderRoster();const data=filtered(),m=metric(data);$('mainDonut').innerHTML=donut(m,true);$('total').textContent=number(m.total);$('open').textContent=number(m.open);$('closed').textContent=number(m.closed);$('disciplines').innerHTML=disciplines.map(d=>{const dm=metric(data.filter(r=>r.discipline===d));return`<article class="discipline"><h3>${esc(d)}</h3>${donut(dm)}<div class="discipline-meta"><span>${dm.closed} cerrados</span><span>${dm.total} total</span></div></article>`}).join('');const ranking=projects.map(p=>({label:p,...metric(rows.filter(r=>r.project===p&&(state.month==='Todos'||key(r.createdOn)===state.month)&&(state.type==='Todos'||r.type===state.type)&&(state.team==='Todos'||r.team===state.team)&&(state.member==='Todos'||r.assignee===state.member)))})).filter(x=>x.total).sort((a,b)=>b.rate-a.rate||b.closed-a.closed).slice(0,5);$('ranking').innerHTML=ranking.map((x,i)=>`<div class="rank"><span class="rank-no">${i+1}</span><div class="rank-info"><div class="rank-label"><strong>${esc(x.label)}</strong><span>${pct(x.rate)}</span></div><div class="bar"><i style="width:${x.rate*100}%"></i></div></div></div>`).join('')||'<div class="empty">Sin datos</div>';
const teamGroups=new Map();data.forEach(r=>teamGroups.set(r.team,[...(teamGroups.get(r.team)||[]),r]));let right='<div class="mini-row mini-head"><span>Equipo</span><span>Usuario</span><span>Total</span><span>Cerrados</span><span>% cerrado</span></div>';[...teamGroups].sort((a,b)=>metric(b[1]).total-metric(a[1]).total).forEach(([team,rs])=>{const tm=metric(rs);right+=`<div class="mini-row team-summary"><span>${esc(team)}</span><span>Equipo</span><b>${tm.total}</b><b class="closed">${tm.closed}</b><b class="rate">${pct(tm.rate)}</b></div>`;const pgs=new Map();rs.forEach(r=>pgs.set(r.assignee,[...(pgs.get(r.assignee)||[]),r]));[...pgs].sort((a,b)=>metric(b[1]).total-metric(a[1]).total).forEach(([user,urs])=>{const um=metric(urs);right+=`<div class="mini-row"><span>${esc(team)}</span><span title="${esc(user)}">${esc(user)}</span><b>${um.total}</b><b class="closed">${um.closed}</b><b class="rate">${pct(um.rate)}</b></div>`})});$('people').innerHTML=right;
const statuses=[...new Set(data.map(r=>r.status))].sort(),assignees=[...new Set(data.map(r=>r.assignee))].sort((a,b)=>a.localeCompare(b,'es'));state.detailStatus=select('detailStatus',statuses,state.detailStatus);state.detailAssignee=select('detailAssignee',assignees,state.detailAssignee);const detailFiltered=data.filter(r=>(state.detailStatus==='Todos'||r.status===state.detailStatus)&&(state.detailAssignee==='Todos'||r.assignee===state.detailAssignee)),details=detailFiltered.slice(0,100);$('details').innerHTML=details.map(r=>`<tr data-issue="${esc(r.id)}" class="${state.selectedIssue===r.id?'selected':''}"><td>${esc(r.id||'—')}</td><td>${esc(r.project)}</td><td class="title" title="${esc(r.title)}">${esc(r.title||'Sin título')}</td><td><span class="pill ${esc(r.status.toLowerCase().replace(/\s+/g,'-'))}">${esc(r.status)}</span></td><td>${esc(r.discipline)}</td><td>${esc(r.team)}</td><td>${esc(r.assignee)}</td><td>${r.createdOn?new Date(r.createdOn).toLocaleDateString('es-MX'):'—'}</td></tr>`).join('');$('details').querySelectorAll('[data-issue]').forEach(tr=>tr.onclick=()=>{state.selectedIssue=state.selectedIssue===tr.dataset.issue?null:tr.dataset.issue;renderDescription(rows.find(r=>r.id===state.selectedIssue));$('details').querySelectorAll('tr').forEach(x=>x.classList.toggle('selected',x.dataset.issue===state.selectedIssue))});renderDescription(rows.find(r=>r.id===state.selectedIssue));$('detailNote').textContent=`Mostrando ${details.length} de ${number(detailFiltered.length)} registros que cumplen los filtros de detalle (${number(data.length)} en la vista actual). Selecciona un issue para ver su descripción.`;const t=trendRows();drawChart($('history'),t,false);drawChart($('rate'),t,true)}
$('monthFilter').onchange=e=>{state.month=e.target.value;state.selectedIssue=null;render()};$('memberFilter').onchange=e=>{state.member=e.target.value;state.selectedIssue=null;render()};$('detailStatus').onchange=e=>{state.detailStatus=e.target.value;state.selectedIssue=null;render()};$('detailAssignee').onchange=e=>{state.detailAssignee=e.target.value;state.selectedIssue=null;render()};$('reset').onclick=()=>{state={project:'Todos',month:'Todos',type:'Todos',team:'Todos',member:'Todos',detailStatus:'Todos',detailAssignee:'Todos',selectedIssue:null};render()};window.onresize=()=>{const t=trendRows();drawChart($('history'),t,false);drawChart($('rate'),t,true)};$('updated').textContent=`Datos: ${snapshot.generatedAt?new Date(snapshot.generatedAt).toLocaleString('es-MX'):'—'} · ${number(snapshot.rowCount||rows.length)} registros`;render();
})();
</script>
