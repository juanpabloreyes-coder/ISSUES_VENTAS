function renderRoster(){const base=baseRows(),teams=availableTeams();if(state.team!=='Todos'&&!teams.includes(state.team))state.team='Todos';$('rosterTitle').textContent=state.project==='Todos'?'EQUIPOS E INTEGRANTES':`EQUIPO EN ${state.project}`;$('rosterList').innerHTML=teams.map(team=>{const rs=base.filter(r=>r.team===team),tm=metric(rs),people=[...new Set(rs.map(r=>r.assignee))].sort((a,b)=>a.localeCompare(b,'es'));return`<div class="roster-team"><button class="roster-team-head${state.team===team?' active':''}" data-team="${esc(team)}"><span>${esc(team)}</span><span class="roster-team-meta">${tm.closed}/${tm.total} · ${pct(tm.rate)}</span></button><div class="roster-members">${people.map(p=>{const pm=metric(rs.filter(r=>r.assignee===p));return`<div class="roster-member"><span title="${esc(p)}">${esc(p)}</span><b>${pm.closed}/${pm.total} · ${pct(pm.rate)}</b></div>`}).join('')}</div></div>`}).join('')||'<div class="empty">Sin equipos</div>';$('rosterList').querySelectorAll('[data-team]').forEach(b=>b.onclick=()=>{state.team=state.team===b.dataset.team?'Todos':b.dataset.team;state.member='Todos';render()})}
function monthRange(start,end){const out=[],d=new Date(`${start}-01T00:00:00Z`),limit=new Date(`${end}-01T00:00:00Z`);while(d<=limit){out.push(`${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}`);d.setUTCMonth(d.getUTCMonth()+1)}return out}
function trendRows(){const source=rows.filter(r=>(state.project==='Todos'||r.project===state.project)&&(state.type==='Todos'||r.type===state.type)&&(state.team==='Todos'||r.team===state.team)&&(state.member==='Todos'||r.assignee===state.member));const keys=[...new Set(source.map(r=>key(r.createdOn)).filter(Boolean))].sort();if(!keys.length)return[];return monthRange(keys[0],keys.at(-1)).map(k=>({label:`${MONTHS[+k.slice(5)-1]} ${k.slice(2,4)}`,...metric(source.filter(r=>key(r.createdOn)===k))}))}
function drawChart(canvas,points,rateOnly=false){const rect=canvas.getBoundingClientRect(),dpr=window.devicePixelRatio||1,w=Math.max(300,rect.width),h=Math.max(175,rect.height);canvas.width=w*dpr;canvas.height=h*dpr;const c=canvas.getContext('2d');c.scale(dpr,dpr);c.clearRect(0,0,w,h);const pad={l:46,r:20,t:20,b:34},pw=w-pad.l-pad.r,ph=h-pad.t-pad.b;c.font='9px Segoe UI';c.lineCap='round';c.lineJoin='round';if(!points.length){c.fillStyle='#86868b';c.fillText('Sin datos',pad.l,pad.t+20);return}const max=rateOnly?1:Math.max(1,...points.map(p=>Math.max(p.total,p.closed)));for(let i=0;i<=3;i++){const yy=pad.t+ph*i/3;c.strokeStyle='rgba(120,120,128,.18)';c.lineWidth=1;c.beginPath();c.moveTo(pad.l,yy);c.lineTo(w-pad.r,yy);c.stroke();const v=max*(1-i/3);c.fillStyle='#708090';c.fillText(rateOnly?pct(v):number(Math.round(v)),5,yy+3)}const x=i=>pad.l+(points.length===1?pw/2:pw*i/(points.length-1)),y=v=>pad.t+ph*(1-v/max);const series=rateOnly?[['rate','#007aff']]:[['total','#007aff'],['closed','#1aa6a6']];series.forEach(([field,col])=>{c.strokeStyle=col;c.lineWidth=2.5;c.beginPath();points.forEach((p,i)=>{const xx=x(i),yy=y(p[field]);i?c.lineTo(xx,yy):c.moveTo(xx,yy)});c.stroke();points.forEach((p,i)=>{const xx=x(i),yy=y(p[field]);c.fillStyle='#fff';c.strokeStyle=col;c.lineWidth=2;c.beginPath();c.arc(xx,yy,3.4,0,Math.PI*2);c.fill();c.stroke();if(rateOnly){c.fillStyle=col;c.font='bold 9px Segoe UI';const label=pct(p.rate);c.fillText(label,Math.max(2,xx-c.measureText(label).width/2),Math.max(10,yy-9));c.font='9px Segoe UI'}})});c.fillStyle='#708090';points.forEach((p,i)=>{if(points.length<=10||i%Math.ceil(points.length/8)===0||i===points.length-1)c.fillText(p.label,x(i)-12,h-8)})}
function renderDescription(r){const box=$('issueDescription');if(!r){box.classList.remove('visible');return}$('descriptionTitle').textContent=`${r.id||'Issue'} · ${r.title||'Sin título'}`;$('descriptionMeta').textContent=`${r.project} · ${r.team} · ${r.assignee}`;$('descriptionText').textContent=r.description||'Este issue no tiene descripción registrada.';box.classList.add('visible')}
function render(){buttons('projectButtons',projects,state.project,v=>{state.project=v;state.team='Todos';state.member='Todos';state.selectedIssue=null;render()});buttons('typeButtons',types,state.type,v=>{state.type=v;state.selectedIssue=null;render()});state.month=select('monthFilter',monthKeys,state.month,k=>`${MONTHS[+k.slice(5)-1]} ${k.slice(0,4)}`);const teams=availableTeams();if(state.team!=='Todos'&&!teams.includes(state.team))state.team='Todos';buttons('teamButtons',teams,state.team,v=>{state.team=v;state.member='Todos';state.selectedIssue=null;render()});const members=availableMembers();state.member=select('memberFilter',members,state.member);renderRoster();const data=filtered(),m=metric(data);$('mainDonut').innerHTML=donut(m,true);$('total').textContent=number(m.total);$('open').textContent=number(m.open);$('closed').textContent=number(m.closed);$('disciplines').innerHTML=disciplines.map(d=>{const dm=metric(data.filter(r=>r.discipline===d));return`<article class="discipline"><h3>${esc(d)}</h3>${donut(dm)}<div class="discipline-meta"><span>${dm.closed} cerrados</span><span>${dm.total} total</span></div></article>`}).join('');const ranking=projects.map(p=>({label:p,...metric(rows.filter(r=>r.project===p&&(state.month==='Todos'||key(r.createdOn)===state.month)&&(state.type==='Todos'||r.type===state.type)&&(state.team==='Todos'||r.team===state.team)&&(state.member==='Todos'||r.assignee===state.member)))})).filter(x=>x.total).sort((a,b)=>b.rate-a.rate||b.closed-a.closed).slice(0,5);$('ranking').innerHTML=ranking.map((x,i)=>`<div class="rank"><span class="rank-no">${i+1}</span><div class="rank-info"><div class="rank-label"><strong>${esc(x.label)}</strong><span>${pct(x.rate)}</span></div><div class="bar"><i style="width:${x.rate*100}%"></i></div></div></div>`).join('')||'<div class="empty">Sin datos</div>';
const teamGroups=new Map();data.forEach(r=>teamGroups.set(r.team,[...(teamGroups.get(r.team)||[]),r]));let right='<div class="mini-row mini-head"><span>Equipo</span><span>Usuario</span><span>Total</span><span>Cerrados</span><span>% cerrado</span></div>';[...teamGroups].sort((a,b)=>metric(b[1]).total-metric(a[1]).total).forEach(([team,rs])=>{const tm=metric(rs);right+=`<div class="mini-row team-summary"><span>${esc(team)}</span><span>Equipo</span><b>${tm.total}</b><b class="closed">${tm.closed}</b><b class="rate">${pct(tm.rate)}</b></div>`;const pgs=new Map();rs.forEach(r=>pgs.set(r.assignee,[...(pgs.get(r.assignee)||[]),r]));[...pgs].sort((a,b)=>metric(b[1]).total-metric(a[1]).total).forEach(([user,urs])=>{const um=metric(urs);right+=`<div class="mini-row"><span>${esc(team)}</span><span title="${esc(user)}">${esc(user)}</span><b>${um.total}</b><b class="closed">${um.closed}</b><b class="rate">${pct(um.rate)}</b></div>`})});$('people').innerHTML=right;
const statuses=[...new Set(data.map(r=>r.status))].sort(),assignees=[...new Set(data.map(r=>r.assignee))].sort((a,b)=>a.localeCompare(b,'es'));state.detailStatus=select('detailStatus',statuses,state.detailStatus);state.detailAssignee=select('detailAssignee',assignees,state.detailAssignee);const detailFiltered=data.filter(r=>(state.detailStatus==='Todos'||r.status===state.detailStatus)&&(state.detailAssignee==='Todos'||r.assignee===state.detailAssignee)),details=detailFiltered.slice(0,100);$('details').innerHTML=details.map(r=>`<tr data-issue="${esc(r.id)}" class="${state.selectedIssue===r.id?'selected':''}"><td>${esc(r.id||'—')}</td><td>${esc(r.project)}</td><td class="title" title="${esc(r.title)}">${esc(r.title||'Sin título')}</td><td><span class="pill ${esc(r.status.toLowerCase().replace(/\s+/g,'-'))}">${esc(r.status)}</span></td><td>${esc(r.discipline)}</td><td>${esc(r.team)}</td><td>${esc(r.assignee)}</td><td>${r.createdOn?new Date(r.createdOn).toLocaleDateString('es-MX'):'—'}</td></tr>`).join('');$('details').querySelectorAll('[data-issue]').forEach(tr=>tr.onclick=()=>{state.selectedIssue=state.selectedIssue===tr.dataset.issue?null:tr.dataset.issue;renderDescription(rows.find(r=>r.id===state.selectedIssue));$('details').querySelectorAll('tr').forEach(x=>x.classList.toggle('selected',x.dataset.issue===state.selectedIssue))});renderDescription(rows.find(r=>r.id===state.selectedIssue));$('detailNote').textContent=`Mostrando ${details.length} de ${number(detailFiltered.length)} registros que cumplen los filtros de detalle (${number(data.length)} en la vista actual). Selecciona un issue para ver su descripción.`;const t=trendRows();drawChart($('history'),t,false);drawChart($('rate'),t,true)}
$('monthFilter').onchange=e=>{state.month=e.target.value;state.selectedIssue=null;render()};$('memberFilter').onchange=e=>{state.member=e.target.value;state.selectedIssue=null;render()};$('detailStatus').onchange=e=>{state.detailStatus=e.target.value;state.selectedIssue=null;render()};$('detailAssignee').onchange=e=>{state.detailAssignee=e.target.value;state.selectedIssue=null;render()};$('reset').onclick=()=>{state={project:'Todos',month:'Todos',type:'Todos',team:'Todos',member:'Todos',detailStatus:'Todos',detailAssignee:'Todos',selectedIssue:null};render()};window.onresize=()=>{const t=trendRows();drawChart($('history'),t,false);drawChart($('rate'),t,true)};$('updated').textContent=`Datos: ${snapshot.generatedAt?new Date(snapshot.generatedAt).toLocaleString('es-MX'):'—'} · ${number(snapshot.rowCount||rows.length)} registros`;render();
})();
</script>
